#!/bin/bash
set -euo pipefail

{{- if eq .chezmoi.os "darwin" }}

if ! command -v brew > /dev/null 2>&1; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
brew install git tmux neovim fzf ripgrep zoxide lazygit yazi rbw

{{- else }}

# Debian/Ubuntu (голый Linux и WSL — apt в обоих случаях)
if [ "$(id -u)" = "0" ]; then
  sudo=""
else
  sudo="sudo"
fi

$sudo apt-get update
$sudo apt-get install -y git tmux neovim fzf ripgrep curl unzip build-essential pkg-config libssl-dev fonts-firacode
{{- if .is_wsl }}
$sudo apt-get install -y wslu
{{- end }}

if ! command -v zoxide > /dev/null 2>&1; then
  curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
fi

# rustup/cargo нужен для yazi и rbw — в apt Debian/Ubuntu их нет
if ! command -v cargo > /dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi
export PATH="$HOME/.cargo/bin:$PATH"
cargo install --locked yazi-fm yazi-cli rbw

if ! command -v lazygit > /dev/null 2>&1; then
  case "{{ .chezmoi.arch }}" in
    amd64) lazygit_arch=x86_64 ;;
    *)     lazygit_arch="{{ .chezmoi.arch }}" ;;
  esac
  lazygit_version=$(curl -fsSL "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name":\s*"v\K[^"]*')
  curl -fsSLo /tmp/lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/download/v${lazygit_version}/lazygit_${lazygit_version}_Linux_${lazygit_arch}.tar.gz"
  tar xf /tmp/lazygit.tar.gz -C /tmp lazygit
  $sudo install /tmp/lazygit /usr/local/bin
  rm -f /tmp/lazygit.tar.gz /tmp/lazygit
fi

{{- end }}
